{
  "schema_version": "1.0",
  "adapters": [
    {
      "id": "python-debugpy",
      "name": "Python debugpy",
      "command": ".venv/bin/python",
      "args": [
        "-m",
        "debugpy.adapter"
      ],
      "languages": [
        "python"
      ],
      "protocol": "DAP",
      "status": "available",
      "capabilities": {
        "breakpoints": true,
        "scopes": true,
        "variables": true,
        "step": true,
        "continue": true,
        "evaluate": true,
        "exceptionBreakpoints": true,
        "conditionalBreakpoints": true
      }
    },
    {
      "id": "node-inspector",
      "name": "Node.js Inspector",
      "command": "node",
      "args": [
        "--inspect-brk"
      ],
      "languages": [
